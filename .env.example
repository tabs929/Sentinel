# ---------------------------------------------------------------------------
# Sentinel configuration
# Copy this file to `.env` and fill in the values you have.
# Every value is optional: missing keys degrade gracefully (tools report
# "unavailable" instead of crashing). The agent itself only needs
# ANTHROPIC_API_KEY to call Claude.
# ---------------------------------------------------------------------------

# --- LLM (required to actually run the agent) ---
ANTHROPIC_API_KEY=
SENTINEL_MODEL=claude-sonnet-4-20250514
SENTINEL_MAX_TOKENS=2048
SENTINEL_MAX_STEPS=8

# --- Storage ---
SENTINEL_DB_PATH=sentinel.db

# --- Guardrails ---
SENTINEL_MAX_INPUT_CHARS=8000

# --- Tools (all optional; absence => tool reports "unavailable") ---
# Weather needs no key (uses open-meteo.com).
GITHUB_TOKEN=
LINEAR_API_KEY=
SLACK_BOT_TOKEN=

# --- Tool retry/timeout tuning ---
SENTINEL_TOOL_MAX_ATTEMPTS=3
SENTINEL_TOOL_TIMEOUT_SECONDS=15
